Windows Registry Editor Version 5.00
;
; NFS Underground 2 - template for Wine / Winlator / empty prefix
;
; --- Sources for required keys (EA did not publish a public registry specification) ---
;
; [A] Full reg dump matching a typical retail install — key names, Product GUID,
;     Registration -> ergc path, 1.0 subkey, Locale/Patch URL pattern, DWORDs, etc.:
;     https://www.regfiles.net/registry/need-for-speed-underground-2-registry
;     (That capture uses example paths and sometimes region_mx; yours may differ by SKU.)
;
; [B] CD key location — HKLM\...\Electronic Arts\...\ergc default value, 20 chars,
;     no dashes (classic EA layout); same era as retail discs:
;     https://www.neowin.net/forum/topic/255761-change-nfs-u2-cd-key/
;
; [C] Product GUID {909F8EBC-EC7F-48FF-0085-475D818F0F31} — same string as [A]; this is
;     the Windows Installer–style product code used with Uninstall\{GUID} entries.
;
; [D] Wow6432Node\EA Games mirror — 32-bit game on 64-bit Windows/Wine uses the WOW64
;     view of HKLM\SOFTWARE (documented Windows behavior; Wine follows it).
;
; [E] Game registry behavior (reverse engineering — keys the EXE actually reads):
;     https://yugecin.github.io/nfsu2-re/docs.html
;     - VERSION/SIZE + graphics DWORDs: HKCU\Software\EA Games\Need for Speed Underground 2
;     - HKLM Install Dir must survive GetLongPathNameA (avoid odd paths under Wine)
;     - Extra CD-key key: HKLM\...\Electronic Arts\EA Games\Need for Speed Underground 2\er
;
; [F] Same error from EA's PATCH installer is often wrong *regional* patch vs installed SKU:
;     https://www.nfsplanet.com/nfs8_patch.php?lang=eng
;     https://www.neowin.net/forum/topic/250876-cannot-install-nfs-u2-patch/
;
; BEFORE IMPORTING - EDIT THESE IN Notepad (keep double backslashes in paths):
;   1) Install Dir + CD Drive + Installed From  -> must match your Wine drive layout
;   2) ergc -> your real retail CD key, 20 characters, NO dashes (same as on disc case)
;
; "Missing or invalid registry / INI entry" often means Install Dir / Product GUID / version
; keys / or CD key (ergc) are absent - patches also complain if region/key mismatch.
;
; Import in Wine:  regedit nfsu2_winlator_template.reg
;              or: wine regedit nfsu2_winlator_template.reg
;
; This file lists BOTH locations:
;   - HKLM\SOFTWARE\EA Games\...           -> pure 32-bit prefix (WINEARCH=win32)
;   - HKLM\SOFTWARE\Wow6432Node\EA Games\... -> 32-bit app on 64-bit prefix (common)
; If one tree fails to import, delete that section and keep the other.
;
; Install / Uninstall paths below use D:\nfs on purpose: that is the game root inside
; Wine/Winlator (same as D:/nfs on disk), i.e. the folder that contains speed2.exe
; (e.g. D:/nfs/speed2.exe). Install Dir, InstallLocation, and UninstallString must all
; point at that same directory—do not add an extra "Need for Speed..." subfolder unless
; you actually installed the game there.
;
; Locale/Patch/Region below are set for UK retail + UK patch URL (EN-UK). US discs: use
; English US, en_us, EN-US patch URL, region_us. Mixed US registry + UK patch (or reverse)
; triggers "Missing or Invalid Registry/INI Entry" on the patch installer.
; If the UK patch still complains, try "Region"="region_uk" (some SKUs differ).
;

; -------- 32-bit prefix (no Wow6432Node) --------

[HKEY_LOCAL_MACHINE\SOFTWARE\EA Games\Need for Speed Underground 2]
"CacheSize"="1879040000"
"CD Drive"="D:\\"
"DisplayName"="Need for Speed Underground 2"
"Folder"="."
"Install Dir"="D:\\nfs"
"Installed From"="D:\\"
"Language"="English UK"
"Locale"="en_uk"
"Patch URL"="http://patches.ea.com/nfs_underground2/EN-UK/home.html"
"Product GUID"="{909F8EBC-EC7F-48FF-0085-475D818F0F31}"
"Region"="region_eu"
"Registration"="SOFTWARE\\Electronic Arts\\EA GAMES\\Need for Speed Underground 2\\ergc"
"Suppression Exe"=""
"SwapSize"="0"
"NotFirstTime"=dword:00000001
"VERSION"=dword:00000001
"SIZE"=dword:00000078

[HKEY_LOCAL_MACHINE\SOFTWARE\EA Games\Need for Speed Underground 2\1.0]
"DisplayName"="Need for Speed Underground 2"
"LanguageName"="English UK"
"Language"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Electronic Arts\EA GAMES\Need for Speed Underground 2\ergc]
@="xxxxxxxxxxxxxxxxxxxx"

; -------- 64-bit Wine (WOW64 view) - same data --------

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\EA Games\Need for Speed Underground 2]
"CacheSize"="1879040000"
"CD Drive"="D:\\"
"DisplayName"="Need for Speed Underground 2"
"Folder"="."
"Install Dir"="D:\\nfs"
"Installed From"="D:\\"
"Language"="English UK"
"Locale"="en_uk"
"Patch URL"="http://patches.ea.com/nfs_underground2/EN-UK/home.html"
"Product GUID"="{909F8EBC-EC7F-48FF-0085-475D818F0F31}"
"Region"="region_eu"
"Registration"="SOFTWARE\\Electronic Arts\\EA GAMES\\Need for Speed Underground 2\\ergc"
"Suppression Exe"=""
"SwapSize"="0"
"NotFirstTime"=dword:00000001
"VERSION"=dword:00000001
"SIZE"=dword:00000078

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\EA Games\Need for Speed Underground 2\1.0]
"DisplayName"="Need for Speed Underground 2"
"LanguageName"="English UK"
"Language"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Electronic Arts\EA GAMES\Need for Speed Underground 2\ergc]
@="xxxxxxxxxxxxxxxxxxxx"

; Alternate CD-key path used by some installers / Neowin-era instructions ("EA Games" casing):
[HKEY_LOCAL_MACHINE\SOFTWARE\Electronic Arts\EA Games\Need for Speed Underground 2\ergc]
@="xxxxxxxxxxxxxxxxxxxx"

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Electronic Arts\EA Games\Need for Speed Underground 2\ergc]
@="xxxxxxxxxxxxxxxxxxxx"

; "er" default string — game reads this from HKLM per nfsu2-re (20 chars, same as CD key):
[HKEY_LOCAL_MACHINE\SOFTWARE\Electronic Arts\EA Games\Need for Speed Underground 2\er]
@="xxxxxxxxxxxxxxxxxxxx"

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Electronic Arts\EA Games\Need for Speed Underground 2\er]
@="xxxxxxxxxxxxxxxxxxxx"

; Graphics + VERSION/SIZE — nfsu2-re: loaded from HKCU (RegFiles also lists these on HKLM):
[HKEY_CURRENT_USER\Software\EA Games\Need for Speed Underground 2]
"VERSION"=dword:00000001
"SIZE"=dword:00000078
"g_CarEnvironmentMapEnable"=dword:00000003
"g_CarEnvironmentMapUpdateData"=dword:00000001
"g_CarShadowEnable"=dword:00000002
"g_CarHeadlightEnable"=dword:00000001
"g_CarLightingEnable"=dword:00000000
"g_CarDamageEnable"=dword:00000000
"g_CrowdEnable"=dword:00000001
"g_RoadReflectionEnable"=dword:00000003
"g_FogEnable"=dword:00000001
"g_MotionBlurEnable"=dword:00000001
"g_LightStreaksEnable"=dword:00000001
"g_LightGlowEnable"=dword:00000001
"g_AnimatedTextureEnable"=dword:00000001
"g_ParticleSystemEnable"=dword:00000001
"g_DepthOfFieldEnable"=dword:00000001
"g_WorldLodLevel"=dword:00000002
"g_CarLodLevel"=dword:00000001
"g_OverBrightEnable"=dword:00000001
"g_BleachByPassEnable"=dword:00000001
"g_TintingEnable"=dword:00000001
"g_FSAALevel"=dword:00000000
"g_HorizonFogEnable"=dword:00000001
"g_RainEnable"=dword:00000001
"g_TextureFiltering"=dword:00000002
"g_RacingResolution"=dword:00000001
"g_PerformanceLevel"=dword:00000005
"g_VSyncOn"=dword:00000001

; App Paths — disc AutoRun/RunGame.exe call into App Paths (strings reference
; SOFTWARE\...\App Paths\ and speed2.exe); optional but matches retail installers:
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\speed2.exe]
@="D:\\nfs\\speed2.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\App Paths\speed2.exe]
@="D:\\nfs\\speed2.exe"

; Uninstall (32-bit prefix)
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{909F8EBC-EC7F-48FF-0085-475D818F0F31}]
"DisplayName"="Need for Speed Underground 2"
"DisplayVersion"="1.0"
"InstallLocation"="D:\\nfs"
"Publisher"="Electronic Arts"
"UninstallString"="\"D:\\nfs\\Uninst.isu\""
"NoModify"=dword:00000001

; Uninstall (64-bit Wine WOW64 – duplicate if your prefix uses Wow6432Node for 32-bit uninstallers)
[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\{909F8EBC-EC7F-48FF-0085-475D818F0F31}]
"DisplayName"="Need for Speed Underground 2"
"DisplayVersion"="1.0"
"InstallLocation"="D:\\nfs"
"Publisher"="Electronic Arts"
"UninstallString"="\"D:\\nfs\\Uninst.isu\""
"NoModify"=dword:00000001
